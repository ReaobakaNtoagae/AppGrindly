<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_profile_title"
            android:textAlignment="center"
            android:textSize="30sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_dark_bold"
            android:layout_marginBottom="15dp"/>

        <!-- Profile Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImageView"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/CircularImageView"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upload_profile_picture_hint"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="5dp"/>

        <!-- Service Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/service_title_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/editServiceTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="@string/service_title_hint"
            android:padding="10dp"
            android:textSize="16sp"
            android:fontFamily="@font/palanquin_semibold"
            android:background="@drawable/edittext"
            android:layout_marginBottom="10dp"/>

        <!-- Category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:entries="@array/category_options"
            android:layout_marginBottom="10dp"/>

        <!-- Location -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/location_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/edittext"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/editLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/location_hint"
                android:fontFamily="@font/palanquin_semibold"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:paddingStart="5dp"/>
        </LinearLayout>

        <!-- Pricing -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pricing_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/editPrice"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/pricing_hint"
            android:textSize="16sp"
            android:paddingStart="10dp"
            android:fontFamily="@font/palanquin_semibold"
            android:background="@drawable/edittext"
            android:layout_marginBottom="5dp"/>

        <Spinner
            android:id="@+id/pricingSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:entries="@array/pricing_options"
            android:layout_marginBottom="10dp"/>

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:padding="6dp"
            android:background="@drawable/edittext"
            android:layout_marginBottom="15dp"/>

        <!-- Work Samples -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/work_samples_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <Button
            android:id="@+id/btnUploadImg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upload_work_samples_button"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_work_samples_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imageRecycler"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/edittext"
            android:layout_marginBottom="15dp"
            tools:listitem="@layout/item_imagespreview"/>

        <!-- Documents -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/documents_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <Button
            android:id="@+id/browsedocuments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upload_verification_documents_button"
            android:background="@drawable/edittext"
            android:fontFamily="@font/palanquin_semibold"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_label"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_bold"
            android:layout_marginBottom="5dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/docRecycler"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/edittext"
            android:layout_marginBottom="20dp"
            tools:listitem="@layout/item_documentpreviews"/>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnDone"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/done_button"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:gravity="center"
            android:backgroundTint="@color/theme_purple"
            app:cornerRadius="15dp"
            app:strokeColor="@color/black"
            app:strokeWidth="1dp"
            android:fontFamily="@font/palanquin_dark_bold"/>
    </LinearLayout>
</ScrollView>
