<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFD"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track Your Service"
            android:textSize="26sp"
            android:textColor="#5C469C"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_dark_bold"
            android:paddingBottom="12dp"/>

        <!-- Booking Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBookingInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBookingInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Booking Info"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:fontFamily="@font/palanquin_semibold"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/tvServiceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Service: Mobile Barber"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:paddingVertical="2dp"/>

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date and Time: Sat, Nov 10 - 14:00"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:paddingVertical="2dp"/>

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Location: 45 Mamelodi Street"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:paddingVertical="2dp"/>

                <TextView
                    android:id="@+id/tvPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Payment: Cash"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:paddingVertical="2dp"/>

                <TextView
                    android:id="@+id/tvNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notes: Please cut short"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:paddingVertical="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hustler Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHustlerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvHustlerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hustler Info"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:fontFamily="@font/palanquin_semibold"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/tvHustlerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name: John D."
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:paddingVertical="2dp"/>

                <TextView
                    android:id="@+id/tvHustlerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone: +27 82 987 6543"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:paddingVertical="2dp"/>


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Roadmap Status Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service Progress"
            android:textSize="20sp"
            android:textColor="#5C469C"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Status 1: Pending -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/circlePending"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/status_circle_gray"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:textColor="#555555"/>
            </LinearLayout>


            <View
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_marginStart="7dp"
                android:background="#E0E0E0"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/circleAccepted"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/status_circle_blue"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accepted"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:textColor="#555555"/>
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_marginStart="7dp"
                android:background="#E0E0E0"/>

            <!-- Status 3: On the Way -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/circleOnTheWay"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/status_circle_yellow"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="On the Way"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:textColor="#555555"/>
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_marginStart="7dp"
                android:background="#E0E0E0"/>

            <!-- Status 4: In Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/circleInProgress"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/status_circle_green"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Progress"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:textColor="#555555"/>
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_marginStart="7dp"
                android:background="#E0E0E0"/>

            <!-- Status 5: Completed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/circleCompleted"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/status_circle_purple"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:textColor="#555555"/>
            </LinearLayout>

        </LinearLayout>


        <TextView
            android:id="@+id/tvETA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ETA: 14:10"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingTop="12dp"
            android:fontFamily="@font/palanquin_semibold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContactHustler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Hustler"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8A2BE2"
            android:layout_marginTop="16dp"
            android:icon="@drawable/ic_call"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>

    </LinearLayout>
</ScrollView>
