<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/palanquin_dark_bold"
            android:text="Log In"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="36sp" />

        <!-- Logo -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:src="@drawable/logo3"
            android:layout_marginTop="8dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="18sp"
            android:fontFamily="@font/palanquin_dark_bold"
            android:textColor="@color/black"
            android:text="Showcase. Connect. Thrive"
            android:layout_marginTop="8dp" />

        <!-- Email label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:fontFamily="@font/palanquin_bold"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:text="Enter your email address:" />

        <!-- Email input -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:padding="8dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/edittext"
            android:inputType="textEmailAddress" />

        <!-- Password label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:fontFamily="@font/palanquin_bold"
            android:textColor="@color/black"
            android:text="Enter your password:" />

        <!-- Password input -->
        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:padding="8dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:inputType="textPassword"
            android:background="@drawable/edittext" />

        <!-- Log In Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/theme_purple"
            android:fontFamily="@font/palanquin_dark_bold"
            android:gravity="center"
            android:text="Log In"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:cornerRadius="15dp"
            app:strokeColor="@color/black"
            app:strokeWidth="1dp" />

        <!-- Google Sign-In -->
        <TextView
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue with Google"
            android:textColor="@color/theme_purple"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="16dp"
            android:fontFamily="@font/palanquin_dark_bold"
            android:textStyle="bold" />

        <!-- Biometric Login -->
        <TextView
            android:id="@+id/tvBiometricLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use fingerprint, face, or PIN"
            android:textColor="@color/theme_purple"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="16dp"
            android:fontFamily="@font/palanquin_dark_bold"
            android:textStyle="bold" />

        <!-- Navigate to Sign-Up -->
        <TextView
            android:id="@+id/tvNoAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create an account"
            android:textColor="@color/theme_purple"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="12dp"
            android:fontFamily="@font/palanquin_dark_bold"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
