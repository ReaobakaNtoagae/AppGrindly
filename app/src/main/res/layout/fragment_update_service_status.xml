<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFD"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Details"
            android:textSize="26sp"
            android:textColor="#5C469C"
            android:textStyle="bold"
            android:fontFamily="@font/palanquin_dark_bold"
            android:paddingBottom="12dp"/>

        <!-- Collapsible Booking Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBookingInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            android:clickable="true"
            android:focusable="true"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBookingInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Click to view booking info"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:fontFamily="@font/palanquin_semibold"/>

                <!-- Hidden details layout -->
                <LinearLayout
                    android:id="@+id/bookingDetailsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="12dp">


                    <TextView
                        android:id="@+id/tvClientPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone: +27 82 123 4567"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:paddingVertical="2dp"/>

                    <TextView
                        android:id="@+id/tvServiceTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Service: Mobile Barber"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:paddingVertical="2dp"/>

                    <TextView
                        android:id="@+id/tvDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Date and Time: Sat, Nov 10 - 14:00"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:paddingVertical="2dp"/>

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location: 45 Mamelodi Street"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:paddingVertical="2dp"/>

                    <TextView
                        android:id="@+id/tvPaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Payment: Cash"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:paddingVertical="2dp"/>

                    <TextView
                        android:id="@+id/tvNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notes: Please cut short"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:paddingVertical="2dp"/>

                    <TextView
                        android:id="@+id/tvCurrentStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Current Status: "
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:paddingVertical="2dp"/>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Update Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Status"
            android:textSize="20sp"
            android:textColor="#5C469C"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccepted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                app:cardCornerRadius="16dp"
                android:backgroundTint="#BBDEFB"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accepted"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:fontFamily="@font/palanquin_bold"/>


            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOnTheWay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                app:cardCornerRadius="16dp"
                android:backgroundTint="#FFF9C4"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="On the Way"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:fontFamily="@font/palanquin_bold"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                app:cardCornerRadius="16dp"
                android:backgroundTint="#C8E6C9"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="In Progress"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:fontFamily="@font/palanquin_bold"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCompleted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                app:cardCornerRadius="16dp"
                android:backgroundTint="#E1BEE7"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Completed"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:fontFamily="@font/palanquin_bold"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
